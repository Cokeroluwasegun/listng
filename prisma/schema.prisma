// This is your Prisma schema file for ListNG
// Database: PostgreSQL on Neon.tech

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// LOCATION HIERARCHY
// ─────────────────────────────────────────────

model State {
  id     String @id @default(cuid())
  name   String @unique
  slug   String @unique
  cities City[]
}

model City {
  id      String   @id @default(cuid())
  name    String
  slug    String
  lga     String?
  stateId String
  state   State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  markets Market[]

  @@unique([slug, stateId])
}

model Market {
  id          String           @id @default(cuid())
  name        String
  slug        String
  description String?
  heroImage   String?
  coverImage  String?
  specialty   String?
  cityId      String
  city        City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  users       User[]
  listings    Listing[]
  heroSpots   MarketHeroSpot[]
  createdAt   DateTime         @default(now())

  @@unique([slug, cityId])
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  Boolean   @default(false)
  name           String
  username       String    @unique
  image          String?
  phone          String?
  streetAddress  String?
  role           Role      @default(INDIVIDUAL)
  marketId       String?
  market         Market?   @relation(fields: [marketId], references: [id])
  // Face recognition
  faceDescriptor Float[]
  isFaceVerified Boolean   @default(false)
  // Account status
  isActive       Boolean   @default(true)
  isSuspended    Boolean   @default(false)
  suspendedAt    DateTime?
  suspendReason  String?
  // Relations
  accounts       Account[]
  sessions       Session[]
  vendorProfile  VendorProfile?
  listings       Listing[]
  subscription   UserSubscription?
  devices        UserDevice[]
  loginHistory   LoginHistory[]
  sentMessages   Message[]        @relation("Sender")
  conversations  ConversationParticipant[]
  savedListings  SavedListing[]
  reviewsGiven   Review[]         @relation("Reviewer")
  reviewsReceived Review[]        @relation("Reviewee")
  notifications  Notification[]
  heroSpots      MarketHeroSpot[]
  payments       Payment[]
  reports        Report[]         @relation("Reporter")
  reportedItems  Report[]         @relation("Reported")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

enum Role {
  INDIVIDUAL
  VENDOR
  ADMIN
}

// Better Auth required models
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ─────────────────────────────────────────────
// VENDOR PROFILE & CAC VERIFICATION
// ─────────────────────────────────────────────

model VendorProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  businessType    String
  description     String?
  logo            String?
  coverImage      String?
  website         String?
  whatsapp        String?
  socialLinks     Json?
  totalSales      Int             @default(0)
  cacVerification CACVerification?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model CACVerification {
  id              String        @id @default(cuid())
  vendorProfileId String        @unique
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  rcNumber        String
  companyName     String?
  companyType     String?       // RC, BN, IT, LLP
  status          String?       // Active, Inactive
  registeredAddress String?
  directors       Json?
  apiProvider     String        @default("prembly")
  apiResponse     Json?
  isVerified      Boolean       @default(false)
  verifiedAt      DateTime?
  expiresAt       DateTime?     // 6-month cache
  createdAt       DateTime      @default(now())
}

// ─────────────────────────────────────────────
// CATEGORIES
// ─────────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  icon        String?
  image       String?
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  parentId    String?
  parent      Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children    Category[] @relation("Subcategories")
  listings    Listing[]
  createdAt   DateTime   @default(now())
}

// ─────────────────────────────────────────────
// LISTINGS
// ─────────────────────────────────────────────

model Listing {
  id            String        @id @default(cuid())
  title         String
  description   String
  price         Decimal       @db.Decimal(12, 2)
  isNegotiable  Boolean       @default(false)
  condition     Condition     @default(USED)
  images        String[]
  status        ListingStatus @default(PENDING)
  views         Int           @default(0)
  isFeatured    Boolean       @default(false)
  featuredUntil DateTime?
  isUrgent      Boolean       @default(false)
  urgentUntil   DateTime?
  attributes    Json?
  tags          String[]
  expiresAt     DateTime?
  // Relations
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  marketId      String
  market        Market        @relation(fields: [marketId], references: [id])
  sellerId      String
  seller        User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  savedBy       SavedListing[]
  reviews       Review[]
  reports       Report[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum Condition {
  NEW
  USED
  REFURBISHED
}

enum ListingStatus {
  PENDING
  ACTIVE
  INACTIVE
  SOLD
  REJECTED
  EXPIRED
}

// ─────────────────────────────────────────────
// PACKAGES & SUBSCRIPTIONS
// ─────────────────────────────────────────────

model Package {
  id                    String             @id @default(cuid())
  name                  String
  slug                  String             @unique
  tagline               String?
  price                 Decimal            @db.Decimal(10, 2)
  durationDays          Int
  maxListings           Int                // -1 = unlimited
  boostFrequencyHours   Int                @default(168) // 7 days default
  heroSpotsPerMonth     Int                @default(0)
  featuredSlotsPerMonth Int                @default(0)
  badge                 String?
  badgeColor            String?
  features              String[]
  isActive              Boolean            @default(true)
  isFree                Boolean            @default(false)
  isPopular             Boolean            @default(false)
  sortOrder             Int                @default(0)
  subscriptions         UserSubscription[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model UserSubscription {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId    String
  package      Package            @relation(fields: [packageId], references: [id])
  listingsUsed Int                @default(0)
  heroSpotsUsed Int               @default(0)
  status       SubscriptionStatus @default(ACTIVE)
  startDate    DateTime           @default(now())
  endDate      DateTime
  autoRenew    Boolean            @default(false)
  paymentRef   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

// ─────────────────────────────────────────────
// MARKET HERO SPOTS
// ─────────────────────────────────────────────

model MarketHeroSpot {
  id         String       @id @default(cuid())
  marketId   String
  market     Market       @relation(fields: [marketId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  subtitle   String?
  image      String
  linkUrl    String?
  ctaText    String?
  spotType   HeroSpotType
  isApproved Boolean      @default(false)
  approvedAt DateTime?
  rejectedAt DateTime?
  rejectReason String?
  startDate  DateTime
  endDate    DateTime
  views      Int          @default(0)
  clicks     Int          @default(0)
  paymentRef String?
  createdAt  DateTime     @default(now())
}

enum HeroSpotType {
  MAIN_BANNER
  OFFER_CARD
  ANNOUNCEMENT
}

// ─────────────────────────────────────────────
// MESSAGING
// ─────────────────────────────────────────────

model Conversation {
  id           String                    @id @default(cuid())
  listingId    String?
  listing      Listing?                  @relation(fields: [listingId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
  lastMessageAt DateTime?
  createdAt    DateTime                  @default(now())
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  unreadCount    Int          @default(0)
  lastReadAt     DateTime?

  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  imageUrl       String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// ─────────────────────────────────────────────
// SECURITY — Device Tracking & Login History
// ─────────────────────────────────────────────

model UserDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceHash  String
  deviceName  String?
  userAgent   String?
  lastIp      String?
  lastCountry String?
  lastCity    String?
  isTrusted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  @@unique([userId, deviceHash])
}

model LoginHistory {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  email      String?
  ip         String?
  country    String?
  city       String?
  deviceHash String?
  userAgent  String?
  riskScore  Int      @default(0)
  status     LoginStatus
  createdAt  DateTime @default(now())
}

enum LoginStatus {
  SUCCESS
  TRIGGERED_OTP
  TRIGGERED_FACE
  FAILED
  BLOCKED
}

// ─────────────────────────────────────────────
// REVIEWS, SAVES, NOTIFICATIONS, REPORTS
// ─────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  reviewerId String
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId String
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  listingId  String?
  listing    Listing? @relation(fields: [listingId], references: [id])
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([reviewerId, revieweeId, listingId])
}

model SavedListing {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())

  @@id([userId, listingId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum NotificationType {
  MESSAGE
  LISTING_APPROVED
  LISTING_REJECTED
  NEW_REVIEW
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  HERO_SPOT_APPROVED
  HERO_SPOT_REJECTED
  SECURITY_ALERT
  GENERAL
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id])
  reportedId   String?
  reported     User?        @relation("Reported", fields: [reportedId], references: [id])
  listingId    String?
  listing      Listing?     @relation(fields: [listingId], references: [id])
  reason       String
  description  String?
  status       ReportStatus @default(PENDING)
  adminNote    String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

// ─────────────────────────────────────────────
// PAYMENTS
// ─────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  type        PaymentType
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("NGN")
  status      PaymentStatus @default(PENDING)
  reference   String        @unique
  provider    String        @default("paystack")
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum PaymentType {
  SUBSCRIPTION
  LISTING_BOOST
  HERO_SPOT
  TOP_AD
  HOMEPAGE_SPOTLIGHT
  URGENT_BADGE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ─────────────────────────────────────────────
// SITE SETTINGS (Admin configurable)
// ─────────────────────────────────────────────

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string") // string | boolean | json | number
  label     String?
  updatedAt DateTime @updatedAt
}
