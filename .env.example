# ================================================
# ListNG — Environment Variables
# Copy this file to .env.local and fill in values
# ================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ListNG

# Database (Neon PostgreSQL)
# Get from: https://neon.tech → Create Project → Connection String
# Neon uses port 5432 for pooled connections (serverless) and 5433 for direct (CI/migrate)
DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"
# Direct connection URL for migrations and heavy scripts (Neon: use port 5433)
DIRECT_URL="postgresql://username:password@host/dbname?sslmode=require"

# Better Auth
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-min-32-chars"
BETTER_AUTH_URL=http://localhost:3000

# UploadThing
# Get from: https://uploadthing.com → Dashboard → API Keys
UPLOADTHING_SECRET=sk_live_xxxx
NEXT_PUBLIC_UPLOADTHING_APP_ID=xxxx

# Pusher (Real-time Chat)
# Get from: https://pusher.com → Create App → Keys
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Paystack (Payments)
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxx

# Prembly / Identitypass (CAC Verification)
# Get from: https://app.prembly.com → API Keys
PREMBLY_API_KEY=
PREMBLY_APP_ID=
# Fallback
DOJAH_APP_ID=
DOJAH_SECRET_KEY=

# Resend (Email)
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=noreply@listng.com.ng

# IP Geolocation (for suspicious login detection)
# Uses Vercel headers in production; this is for local dev fallback
IPINFO_TOKEN=

# Upstash Redis (rate limiting, session cache)
# Get from: https://console.upstash.com → Create Database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (error monitoring) — optional but recommended
# Get from: https://sentry.io → New Project → Next.js
SENTRY_DSN=https://96111322d118c77a220accde9f402a62@o4512026446266368.ingest.de.sentry.io/4512026646478928
NEXT_PUBLIC_SENTRY_DSN=https://96111322d118c77a220accde9f402a62@o4512026446266368.ingest.de.sentry.io/4512026646478928
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Comma-separated list of additional allowed origins for CSRF checks
ALLOWED_ORIGINS=

# Cron job secret (protect /api/cron/* routes)
# Generate: openssl rand -hex 32
CRON_SECRET=
